// ============================================================================
// secrets.h  -  CONFIGURACAO DESTE APARELHO
// ============================================================================
// Copie este arquivo para "secrets.h" (na mesma pasta) e preencha os valores.
// O app de setup (setup.bat, na raiz do projeto) faz isso por voce.
// "secrets.h" esta no .gitignore: nao vai para o GitHub.
// ============================================================================
#pragma once

// Nome deste aparelho. Use um nome diferente em cada ESP32 ("no1", "no2"...).
#define NODE_ID "no1"

// Painel do Supabase -> Project Settings -> Data API
//   URL: Project URL        KEY: chave anon / publishable (NUNCA a service_role)
const char* SUPABASE_URL = "https://SEU-PROJETO.supabase.co";
const char* SUPABASE_KEY = "COLE-AQUI-A-CHAVE-ANON-PUBLISHABLE";

// Estado inicial do envio ao Supabase. false = comeca desligado (liga com "s 1"
// no Serial Monitor). true = ja comeca enviando (recomendado para uso diario).
#define ENVIAR_SUPABASE_PADRAO false
